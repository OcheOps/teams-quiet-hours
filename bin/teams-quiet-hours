#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"

DEFAULT_START="09:00"
DEFAULT_END="17:00"
DEFAULT_TIMEZONE=""
DEFAULT_BROWSER="chrome"

POLICY_FILE_NAME="teams-quiet-hours.json"
CLI_NAME="teams-quiet-hours"

SYSTEM_PREFIX="${TEAMS_QUIET_HOURS_SYSTEM_PREFIX:-}"
BIN_DIR="${TEAMS_QUIET_HOURS_BIN_DIR:-${SYSTEM_PREFIX}/usr/local/bin}"
CRON_DIR="${TEAMS_QUIET_HOURS_CRON_DIR:-${SYSTEM_PREFIX}/etc/cron.d}"
CONFIG_DIR="${TEAMS_QUIET_HOURS_CONFIG_DIR:-${SYSTEM_PREFIX}/etc/teams-quiet-hours}"
CHROME_POLICY_DIR="${TEAMS_QUIET_HOURS_CHROME_POLICY_DIR:-${SYSTEM_PREFIX}/etc/opt/chrome/policies/managed}"
CHROMIUM_POLICY_DIR="${TEAMS_QUIET_HOURS_CHROMIUM_POLICY_DIR:-${SYSTEM_PREFIX}/etc/chromium/policies/managed}"
CHROMIUM_BROWSER_POLICY_DIR="${TEAMS_QUIET_HOURS_CHROMIUM_BROWSER_POLICY_DIR:-${SYSTEM_PREFIX}/etc/chromium-browser/policies/managed}"

CONFIG_FILE="${CONFIG_DIR}/config"
CRON_FILE="${CRON_DIR}/teams-quiet-hours"
INSTALL_TARGET="${BIN_DIR}/${CLI_NAME}"

COMMAND=""
BROWSER="$DEFAULT_BROWSER"
START_TIME="$DEFAULT_START"
END_TIME="$DEFAULT_END"
TIMEZONE="$DEFAULT_TIMEZONE"
DRY_RUN=0

usage() {
  cat <<'EOF'
teams-quiet-hours - block Microsoft Teams web notifications in Chrome outside work hours

Usage:
  teams-quiet-hours install [--browser chrome|chromium|all] [--start HH:MM] [--end HH:MM] [--timezone TZ] [--dry-run]
  teams-quiet-hours uninstall [--browser chrome|chromium|all] [--dry-run]
  teams-quiet-hours block [--browser chrome|chromium|all] [--dry-run]
  teams-quiet-hours allow [--browser chrome|chromium|all] [--dry-run]
  teams-quiet-hours status [--browser chrome|chromium|all]
  teams-quiet-hours config

Commands:
  install     Install the CLI, default config, and cron schedule.
  uninstall   Remove managed policy, cron schedule, installed CLI, and config.
  block       Write Chrome/Chromium managed policy to block Teams notifications.
  allow       Remove only the teams-quiet-hours managed policy file.
  status      Show config, cron, installation, and policy state.
  config      Print the active configuration.

Options:
  --browser chrome|chromium|all  Browser policy target. Default: chrome.
  --start HH:MM                  Weekday notification allow start. Default: 09:00.
  --end HH:MM                    Weekday notification allow end. Default: 17:00.
  --timezone TZ                  Optional cron timezone, for example Africa/Lagos.
  --dry-run                      Print intended changes without writing files.
  -h, --help                     Show help.
  --version                      Show version.
EOF
}

log() {
  printf '%s\n' "$*"
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

require_root_for_write() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    return 0
  fi

  if [[ -n "$SYSTEM_PREFIX" ]]; then
    return 0
  fi

  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    die "this command writes to system paths and must be run with sudo/root"
  fi
}

validate_time() {
  local value="$1"
  [[ "$value" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || return 1
}

validate_browser() {
  case "$1" in
    chrome|chromium|all) return 0 ;;
    *) return 1 ;;
  esac
}

quote_shell() {
  local value="$1"
  printf "'%s'" "${value//\'/\'\\\'\'}"
}

policy_json() {
  cat <<'EOF'
{
  "NotificationsBlockedForUrls": [
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*"
  ]
}
EOF
}

validate_policy_json() {
  if command -v jq >/dev/null 2>&1; then
    policy_json | jq -e '.NotificationsBlockedForUrls | type == "array" and length == 2' >/dev/null
    return
  fi

  if command -v python3 >/dev/null 2>&1; then
    policy_json | python3 -m json.tool >/dev/null
    return
  fi

  die "cannot validate JSON: install jq or python3"
}

browser_policy_dirs() {
  case "$BROWSER" in
    chrome)
      printf '%s\n' "$CHROME_POLICY_DIR"
      ;;
    chromium)
      printf '%s\n' "$CHROMIUM_POLICY_DIR" "$CHROMIUM_BROWSER_POLICY_DIR"
      ;;
    all)
      printf '%s\n' "$CHROME_POLICY_DIR" "$CHROMIUM_POLICY_DIR" "$CHROMIUM_BROWSER_POLICY_DIR"
      ;;
  esac
}

run_mkdir() {
  local dir="$1"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "DRY-RUN: create directory $dir"
  else
    mkdir -p "$dir"
  fi
}

run_write_file() {
  local path="$1"
  local mode="$2"
  local content="$3"
  local dir
  dir="$(dirname "$path")"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "DRY-RUN: write $path"
    printf '%s\n' "$content"
    return
  fi

  mkdir -p "$dir"
  umask 022
  printf '%s\n' "$content" > "$path"
  chmod "$mode" "$path"
}

run_remove_file() {
  local path="$1"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "DRY-RUN: remove $path"
  else
    rm -f "$path"
  fi
}

load_config_if_present() {
  if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
    BROWSER="${TEAMS_QUIET_HOURS_BROWSER:-$BROWSER}"
    START_TIME="${TEAMS_QUIET_HOURS_START:-$START_TIME}"
    END_TIME="${TEAMS_QUIET_HOURS_END:-$END_TIME}"
    TIMEZONE="${TEAMS_QUIET_HOURS_TIMEZONE:-$TIMEZONE}"
  fi
}

parse_args() {
  if [[ "$#" -eq 0 ]]; then
    usage
    exit 1
  fi

  COMMAND="$1"
  shift

  case "$COMMAND" in
    install|uninstall|block|allow|status|config) ;;
    -h|--help)
      usage
      exit 0
      ;;
    --version)
      log "$CLI_NAME $VERSION"
      exit 0
      ;;
    *)
      die "unknown command: $COMMAND"
      ;;
  esac

  if [[ "$COMMAND" != "install" ]]; then
    load_config_if_present
  fi

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --browser)
        [[ "$#" -ge 2 ]] || die "--browser requires a value"
        BROWSER="$2"
        shift 2
        ;;
      --start)
        [[ "$#" -ge 2 ]] || die "--start requires a value"
        START_TIME="$2"
        shift 2
        ;;
      --end)
        [[ "$#" -ge 2 ]] || die "--end requires a value"
        END_TIME="$2"
        shift 2
        ;;
      --timezone)
        [[ "$#" -ge 2 ]] || die "--timezone requires a value"
        TIMEZONE="$2"
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown option: $1"
        ;;
    esac
  done

  validate_browser "$BROWSER" || die "--browser must be chrome, chromium, or all"
  validate_time "$START_TIME" || die "--start must use HH:MM in 24-hour time"
  validate_time "$END_TIME" || die "--end must use HH:MM in 24-hour time"
}

write_policy() {
  local dir

  require_root_for_write
  validate_policy_json

  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue
    run_mkdir "$dir"
    run_write_file "${dir}/${POLICY_FILE_NAME}" 0644 "$(policy_json)"
    log "Blocked Teams notifications via ${dir}/${POLICY_FILE_NAME}"
  done < <(browser_policy_dirs)
}

remove_policy() {
  local dir

  require_root_for_write

  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue
    run_remove_file "${dir}/${POLICY_FILE_NAME}"
    log "Allowed Teams notifications by removing ${dir}/${POLICY_FILE_NAME}"
  done < <(browser_policy_dirs)
}

config_content() {
  cat <<EOF
TEAMS_QUIET_HOURS_BROWSER=$(quote_shell "$BROWSER")
TEAMS_QUIET_HOURS_START=$(quote_shell "$START_TIME")
TEAMS_QUIET_HOURS_END=$(quote_shell "$END_TIME")
TEAMS_QUIET_HOURS_TIMEZONE=$(quote_shell "$TIMEZONE")
EOF
}

cron_content() {
  local start_hour start_min end_hour end_min cron_tz
  start_hour="${START_TIME%:*}"
  start_min="${START_TIME#*:}"
  end_hour="${END_TIME%:*}"
  end_min="${END_TIME#*:}"
  start_hour="$((10#$start_hour))"
  start_min="$((10#$start_min))"
  end_hour="$((10#$end_hour))"
  end_min="$((10#$end_min))"
  cron_tz=""

  if [[ -n "$TIMEZONE" ]]; then
    cron_tz="CRON_TZ=${TIMEZONE}"$'\n'
  fi

  cat <<EOF
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
${cron_tz}${start_min} ${start_hour} * * 1-5 root ${INSTALL_TARGET} allow --browser ${BROWSER}
${end_min} ${end_hour} * * 1-5 root ${INSTALL_TARGET} block --browser ${BROWSER}
0 0 * * 6,0 root ${INSTALL_TARGET} block --browser ${BROWSER}
EOF
}

install_cli() {
  local source_path
  source_path="${BASH_SOURCE[0]}"

  require_root_for_write

  run_write_file "$CONFIG_FILE" 0644 "$(config_content)"
  run_write_file "$CRON_FILE" 0644 "$(cron_content)"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "DRY-RUN: install CLI to $INSTALL_TARGET from $source_path"
  else
    mkdir -p "$BIN_DIR"
    install -m 0755 "$source_path" "$INSTALL_TARGET"
  fi

  log "Installed $CLI_NAME"
  log "Schedule: allow Monday-Friday at $START_TIME, block Monday-Friday at $END_TIME, block weekends at 00:00"
  [[ -n "$TIMEZONE" ]] && log "Cron timezone: $TIMEZONE"
  log "Browser target: $BROWSER"
}

uninstall_cli() {
  require_root_for_write
  remove_policy
  run_remove_file "$CRON_FILE"
  run_remove_file "$INSTALL_TARGET"
  run_remove_file "$CONFIG_FILE"
  log "Uninstalled $CLI_NAME"
}

print_config() {
  log "Browser: $BROWSER"
  log "Weekday allow start: $START_TIME"
  log "Weekday allow end: $END_TIME"
  if [[ -n "$TIMEZONE" ]]; then
    log "Timezone: $TIMEZONE"
  else
    log "Timezone: system cron timezone"
  fi
  log "Config file: $CONFIG_FILE"
}

print_status() {
  local dir path state

  print_config
  if [[ -x "$INSTALL_TARGET" ]]; then
    log "CLI installed: yes ($INSTALL_TARGET)"
  else
    log "CLI installed: no ($INSTALL_TARGET)"
  fi

  if [[ -f "$CRON_FILE" ]]; then
    log "Cron installed: yes ($CRON_FILE)"
  else
    log "Cron installed: no ($CRON_FILE)"
  fi

  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue
    path="${dir}/${POLICY_FILE_NAME}"
    if [[ -f "$path" ]]; then
      state="blocked"
    else
      state="allowed"
    fi
    log "Policy state for $path: $state"
  done < <(browser_policy_dirs)
}

main() {
  parse_args "$@"

  case "$COMMAND" in
    install) install_cli ;;
    uninstall) uninstall_cli ;;
    block) write_policy ;;
    allow) remove_policy ;;
    status) print_status ;;
    config) print_config ;;
  esac
}

main "$@"
